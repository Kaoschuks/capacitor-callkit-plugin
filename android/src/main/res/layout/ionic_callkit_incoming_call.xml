<?xml version="1.0" encoding="utf-8"?>
<!-- Native incoming-call screen (IncomingCallActivity). Override this file in your app to restyle it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/ionic_callkit_app_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="72dp"
        android:textColor="@color/ionic_callkit_secondary_text"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/ionic_callkit_caller_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="2"
        android:textColor="@color/ionic_callkit_primary_text"
        android:textSize="34sp" />

    <TextView
        android:id="@+id/ionic_callkit_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/ionic_callkit_secondary_text"
        android:textSize="18sp" />

    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="64dp"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/ionic_callkit_decline"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@drawable/ionic_callkit_button_decline"
                android:contentDescription="@string/ionic_callkit_decline"
                android:src="@drawable/ionic_callkit_ic_call_end" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/ionic_callkit_decline"
                android:textColor="@color/ionic_callkit_primary_text"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/ionic_callkit_answer"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@drawable/ionic_callkit_button_answer"
                android:contentDescription="@string/ionic_callkit_answer"
                android:src="@drawable/ionic_callkit_ic_call" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/ionic_callkit_answer"
                android:textColor="@color/ionic_callkit_primary_text"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
